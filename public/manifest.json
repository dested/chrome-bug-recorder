{
  "manifest_version": 3,
  "name": "Gripe",
  "version": "0.1.0",
  "description": "Rant at your app, get a bug report. Point at what is broken, say what is wrong, hand the markdown to your coding agent.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Gripe — open panel",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "arm-element": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Arm capture (element picker)"
    },
    "arm-page": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Quick note about the whole page"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
